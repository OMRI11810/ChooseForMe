# Copy to .env for local overrides (git-ignored). All values are optional in
# local development — defaults just work with `npm run dev`.

# Database (defaults to backend/chooseforme.db).
# Railway Postgres example:
#   CHOOSEFORME_DATABASE_URL=postgresql://user:password@host:5432/railway
# SQLite on a mounted volume (/data) example:
#   CHOOSEFORME_DATABASE_URL=sqlite:////data/chooseforme.db
# CHOOSEFORME_DATABASE_URL=

# Browser origins allowed to call the API (JSON array). The Vite dev server
# origins are always included.
# CHOOSEFORME_CORS_ORIGINS=["https://your-frontend.vercel.app"]

# Optional wildcard matcher for origins that change per deploy
# (e.g. every Vercel preview URL):
# CHOOSEFORME_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Verbose mode (only affects SQL echo; leave false in production).
# CHOOSEFORME_DEBUG=false